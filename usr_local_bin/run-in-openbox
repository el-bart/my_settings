#!/bin/bash
set -euo pipefail

tmp=$(mktemp "/tmp/.run-in-openbox-cmd.XXXXXX")
trap "rm -f '$tmp'" EXIT
chmod u+x "$tmp"

cat >> "$tmp" <<EOF
#!/bin/bash
set -euo pipefail
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
trap 'openbox --exit' EXIT
cd $(printf '%q ' "$PWD")
$(printf '%q ' "$@")
EOF

openbox --startup "$tmp"
